{
  "Application": {
    "FrontendUrl": "https://titanmdm.empresa.local"
  },

  "Cors": {
    "AllowedOrigins": [
      "https://titanmdm.empresa.local"
    ]
  },

  "Security": {
    "RequireHttps": true
  },

  "SignalR": {
    "EnableDetailedErrors": false
  },

  "WindowsAgentDistribution": {
    "PublicServerUrl": "https://titanmdm.empresa.local"
  },

  "DataProtection": {
    "KeyRingPath": "C:\\ProgramData\\TitanMDM\\DataProtectionKeys"
  },

  "Inventory": {
    "TimeZoneId": "America/Santo_Domingo"
  },

  "Remediation": {
    "Windows": {
      "Enabled": true,
      "CooldownMinutes": 60,
      "CommandExpirationMinutes": 60,
      "VerifyAfterRemediation": true,
      "ActorUserEmail": ""
    }
  },

  "Ponches": {
    "BaseUrl": "http://127.0.0.1:8127",
    "TimeoutSeconds": 180
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "TitanMDM": "Information"
      }
    }
  },

  "AllowedHosts": "*"
}
