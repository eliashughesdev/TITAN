<?xml version="1.0" encoding="utf-8"?>
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">

    <restriction
        android:key="titan_company_name"
        android:title="Empresa"
        android:restrictionType="string"
        android:defaultValue="TitanMDM Enterprise" />

    <restriction
        android:key="titan_welcome_message"
        android:title="Mensaje corporativo"
        android:restrictionType="string"
        android:defaultValue="Dispositivo corporativo" />

    <restriction
        android:key="titan_primary_color"
        android:title="Color principal (#RRGGBB)"
        android:restrictionType="string"
        android:defaultValue="#16A36A" />

    <restriction
        android:key="titan_background_color"
        android:title="Color de fondo (#RRGGBB)"
        android:restrictionType="string"
        android:defaultValue="#0B1720" />

    <restriction
        android:key="titan_allowed_apps"
        android:title="Aplicaciones autorizadas"
        android:restrictionType="string"
        android:defaultValue="[]" />

    <restriction
        android:key="titan_launcher_enabled"
        android:title="Habilitar Titan Launcher"
        android:restrictionType="bool"
        android:defaultValue="false" />

    <restriction
        android:key="titan_launcher_schema_version"
        android:title="Versión de esquema del launcher"
        android:restrictionType="integer"
        android:defaultValue="1" />

    <restriction
        android:key="titan_wallpaper_url"
        android:title="Fondo del launcher (HTTPS)"
        android:restrictionType="string"
        android:defaultValue="" />

    <restriction
        android:key="titan_logo_url"
        android:title="Logotipo del launcher (HTTPS)"
        android:restrictionType="string"
        android:defaultValue="" />

    <restriction
        android:key="titan_grid_columns"
        android:title="Columnas de la cuadrícula"
        android:restrictionType="integer"
        android:defaultValue="4" />

    <restriction
        android:key="titan_secondary_color"
        android:title="Color secundario (#RRGGBB)"
        android:restrictionType="string"
        android:defaultValue="#0F7A50" />

    <restriction
        android:key="titan_text_color"
        android:title="Color del texto (#RRGGBB)"
        android:restrictionType="string"
        android:defaultValue="#F4F7F8" />

    <restriction
        android:key="titan_card_color"
        android:title="Color de tarjeta (#RRGGBB)"
        android:restrictionType="string"
        android:defaultValue="#142831" />

    <restriction
        android:key="titan_card_text_color"
        android:title="Color del texto de tarjeta (#RRGGBB)"
        android:restrictionType="string"
        android:defaultValue="#F4F7F8" />

    <restriction
        android:key="titan_button_color"
        android:title="Color de botones (#RRGGBB)"
        android:restrictionType="string"
        android:defaultValue="#16A36A" />

    <restriction
        android:key="titan_border_radius"
        android:title="Radio de borde"
        android:restrictionType="integer"
        android:defaultValue="16" />

    <restriction
        android:key="titan_card_opacity"
        android:title="Opacidad de tarjeta"
        android:restrictionType="integer"
        android:defaultValue="100" />

    <restriction
        android:key="titan_shadow"
        android:title="Intensidad de sombra"
        android:restrictionType="integer"
        android:defaultValue="40" />

    <restriction
        android:key="titan_icon_size"
        android:title="Tamaño de icono"
        android:restrictionType="integer"
        android:defaultValue="56" />

    <restriction
        android:key="titan_grid_gap"
        android:title="Separación de la cuadrícula"
        android:restrictionType="integer"
        android:defaultValue="12" />

    <restriction
        android:key="titan_image_fit"
        android:title="Ajuste de imagen"
        android:restrictionType="choice"
        android:entries="@array/titan_image_fit_labels"
        android:entryValues="@array/titan_image_fit_values"
        android:defaultValue="cover" />

    <restriction
        android:key="titan_theme_preset"
        android:title="Preajuste de tema"
        android:restrictionType="choice"
        android:entries="@array/titan_theme_preset_labels"
        android:entryValues="@array/titan_theme_preset_values"
        android:defaultValue="corporate" />

    <restriction
        android:key="titan_config_version"
        android:title="Versión de configuración"
        android:restrictionType="integer"
        android:defaultValue="0" />

    <restriction
        android:key="titan_profile_id"
        android:title="Identificador del perfil"
        android:restrictionType="string"
        android:defaultValue="" />

    <restriction
        android:key="titan_publication_id"
        android:title="Identificador de publicación"
        android:restrictionType="string"
        android:defaultValue="" />

    <restriction
        android:key="titan_updated_at"
        android:title="Última actualización UTC"
        android:restrictionType="string"
        android:defaultValue="" />

</restrictions>
