{
  "PythonService": {
    "Enabled": true,
    "WorkingDirectory": "../ponches",
    "PythonExecutable": ".venv/Scripts/python.exe",
    "AppModule": "app.main:app",
    "RestartDelaySeconds": 5,
    "MaxRestartDelaySeconds": 60
  },

  "Application": {
    "FrontendUrl": "http://localhost:3020"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3020",
      "http://172.21.20.14:3020"
    ]
  },

  "Security": {
    "RequireHttps": false
  },

  "SignalR": {
    "EnableDetailedErrors": true
  },

  "WindowsAgentDistribution": {
    "PublicServerUrl": "http://172.21.20.14:8020"
  },

  "Inventory": {
    "TimeZoneId": "America/Santo_Domingo",
    "WifiAccessPoints": []
  },

  "Remediation": {
    "Windows": {
      "Enabled": true,
      "CooldownMinutes": 60,
      "CommandExpirationMinutes": 60,
      "VerifyAfterRemediation": true,
      "ActorUserEmail": ""
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }

  },

 "AI": {
  "Fiorella": {
    "Model": "nvidia/nemotron-3-ultra-550b-a55b:free"
  },
  "OpenRouter": {
    "Enabled": true,
    "BaseUrl": "https://openrouter.ai/api/v1",
    "Model": "openrouter/free",
    "AssistantModel": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "ClassificationModel": "openrouter/free",
    "AutomationModel": "openrouter/free",
    "ApplicationTitle": "TitanMDM",
    "AppName": "TitanMDM",
    "SiteUrl": "",
    "TimeoutSeconds": 60,
    "MaxRetries": 3,
    "RetryBaseDelayMilliseconds": 750,
    "MaxTokens": 1200,
    "Temperature": 0.2,
    "EnableAssistant": true,
    "EnableClassification": true,
    "EnableAutomation": true
  }
},

"Cache": {
  "DashboardSeconds": 20,
  "DeviceHealthSeconds": 10,
  "RecordsSeconds": 15,
  "EmployeesSeconds": 120,
  "DevicesSeconds": 30,
  "CatalogSeconds": 300,
  "ReportsSeconds": 30
},

  "AllowedHosts": "*"


}